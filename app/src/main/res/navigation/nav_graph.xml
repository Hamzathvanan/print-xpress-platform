<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.printxpress.app.ui.LoginFragment"
        android:label="Sign in">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.printxpress.app.ui.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.printxpress.app.ui.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_category"
            app:destination="@id/categoryFragment" />
        <action
            android:id="@+id/action_home_to_product"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_home_to_orders"
            app:destination="@id/ordersFragment" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_home_to_notifications"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_home_to_guidelines"
            app:destination="@id/guidelinesFragment" />
        <action
            android:id="@+id/action_home_to_faq"
            app:destination="@id/faqFragment" />
    </fragment>

    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.printxpress.app.ui.CategoryFragment"
        android:label="Category">
        <argument
            android:name="category"
            app:argType="string" />
        <action
            android:id="@+id/action_category_to_product"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.printxpress.app.ui.ProductDetailFragment"
        android:label="Product">
        <argument
            android:name="productId"
            app:argType="string" />
        <action
            android:id="@+id/action_product_to_place_order"
            app:destination="@id/placeOrderFragment" />
    </fragment>

    <fragment
        android:id="@+id/placeOrderFragment"
        android:name="com.printxpress.app.ui.PlaceOrderFragment"
        android:label="Place order">
        <argument
            android:name="productId"
            app:argType="string" />
        <action
            android:id="@+id/action_place_order_to_detail"
            app:destination="@id/orderDetailFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.printxpress.app.ui.OrdersFragment"
        android:label="Orders">
        <action
            android:id="@+id/action_orders_to_detail"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.printxpress.app.ui.OrderDetailFragment"
        android:label="Order detail">
        <argument
            android:name="orderId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.printxpress.app.ui.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_addresses"
            app:destination="@id/addressesFragment" />
        <action
            android:id="@+id/action_profile_to_designs"
            app:destination="@id/designsFragment" />
        <action
            android:id="@+id/action_profile_to_orders"
            app:destination="@id/ordersFragment" />
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/addressesFragment"
        android:name="com.printxpress.app.ui.AddressesFragment"
        android:label="Addresses" />

    <fragment
        android:id="@+id/designsFragment"
        android:name="com.printxpress.app.ui.DesignsFragment"
        android:label="Designs" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.printxpress.app.ui.NotificationsFragment"
        android:label="Notifications" />

    <fragment
        android:id="@+id/guidelinesFragment"
        android:name="com.printxpress.app.ui.GuidelinesFragment"
        android:label="Guidelines" />

    <fragment
        android:id="@+id/faqFragment"
        android:name="com.printxpress.app.ui.FaqFragment"
        android:label="FAQ" />
</navigation>
